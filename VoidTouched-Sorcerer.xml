<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
		<name>Sorcerer</name>
		<description>Sorcerer from the Player’s Handbook.</description>
		<author url="http://dnd.wizards.com/products/tabletop-games/rpg-products/rpg_playershandbook">Wizards of the Coast</author>
		<update version="0.2.9">
			<file name="class-sorcerer.xml" url="https://raw.githubusercontent.com/AuroraLegacy/elements/master/core/players-handbook/classes/class-sorcerer.xml" />
		</update>
	</info>

	<element name="Void-Corrupted Bloodline" type="Archetype" source="Homebrew" id="ID_VOID_SORCERER_VOID_CORRUPTED">
		<supports>Sorcerous Origin</supports>
		<description>
			<p>Your draconic heritage has been severed and devoured by the Void. What remains is something colder, deeper, and profoundly unnatural. The Weave recoils from you… but the Void answers.</p>
		</description>
		<sheet display="false"/>
		<rules>
			<grant type="Class Feature" id="ID_VOID_FEATURE_ANCESTRY" level="1"/>
			<grant type="Class Feature" id="ID_VOID_FEATURE_RESILIENCE" level="1"/>
			<grant type="Class Feature" id="ID_VOID_FEATURE_EYES" level="1"/>
			<grant type="Class Feature" id="ID_VOID_FEATURE_ABYSSAL_CHILL" level="6"/>
			<grant type="Class Feature" id="ID_VOID_FEATURE_INESCAPABLE_COLD" level="14"/>
			<grant type="Class Feature" id="ID_VOID_FEATURE_LEVEL18" level="18"/>
		</rules>
	</element>

	<element name="Void-Corrupted Ancestry" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_ANCESTRY">
		<description>
			<p><strong>Level 1 – Void-Corrupted Ancestry</strong></p>
			<p>You gain darkvision out to 120 feet.</p>
			<p>You can speak, read, and write Draconic.</p>
			<p><strong>Void Disdain:</strong> When interacting with dragons, you cannot benefit from proficiency bonuses on Charisma checks. Dragons instinctively recognise you as something wrong.</p>
		</description>
	</element>

	<element name="Voidborn Resilience" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_RESILIENCE">
		<description>
			<p><strong>Level 1 – Voidborn Resilience</strong></p>
			<p>Your hit point maximum increases by 1, and increases by 1 again whenever you gain a level in this class.</p>
			<p>When not wearing armour, your AC equals 13 + your Dexterity modifier.</p>
		</description>
		<rules>
			<stat name="hp" value="1" bonus="base" level="1"/>
			<stat name="ac:calculation" value="13+dexterity:modifier" bonus="base"/>
		</rules>
	</element>

	<element name="Eyes of the Void" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_EYES">
		<description>
			<p><strong>Level 3 – Eyes of the Void</strong></p>
			<p>You learn the <i>Darkness</i> spell; it does not count against your spells known.</p>
			<p>You can cast <i>Darkness</i> by spending 2 sorcery points or using a spell slot.</p>
			<p><strong>Void Sight (Limited):</strong> When you cast <i>Darkness</i> using sorcery points, you can see through it.</p>
			<p>You can use this feature a number of times equal to your proficiency bonus per long rest.</p>
		</description>
		<rules>
			<grant type="Spell" id="ID_PHB_SPELL_DARKNESS"/>
		</rules>
	</element>

	<element name="Abyssal Chill" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_ABYSSAL_CHILL">
		<description>
			<p><strong>Level 6 – Abyssal Chill</strong></p>
			<p>When you cast a spell that deals cold damage, add your Charisma modifier to one damage roll of that spell.</p>
			<p>You can spend 1 sorcery point to gain resistance to cold damage for 1 hour.</p>
		</description>
	</element>

	<element name="Inescapable Cold" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_INESCAPABLE_COLD">
		<description>
			<p><strong>Level 12 – Inescapable Cold</strong></p>
			<p>Your cold damage ignores resistance to cold damage.</p>
			<p>When you roll damage for a spell that deals cold damage, you can reroll a number of damage dice up to your Charisma modifier (minimum 1). You must use the new rolls.</p>
			<p><strong>Shatter the Absolute (Limited):</strong> When you deal cold damage to a creature that is immune to cold damage, you can treat that immunity as resistance instead.</p>
			<p>You can use this feature a number of times equal to your proficiency bonus per long rest.</p>
		</description>
	</element>

	<element name="Void Feature (Level 18)" type="Class Feature" source="Homebrew" id="ID_VOID_FEATURE_LEVEL18">
		<description>
			<p><strong>Level 18 – </strong></p>
			<p></p>
		</description>
	</element>

	<!--Feature Replacement Grants-->
	<element name="Spellcasting Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_SPELLCASTING" />
	<element name="Sorcerous Origin Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_SORCEROUS_ORIGIN" />
	<element name="Font of Magic Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_FONT_OF_MAGIC" />
	<element name="Metamagic Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_METAMAGIC" />
	<element name="Ability Score Improvement Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_ABILITY_SCORE_IMPROVEMENT" />
	<element name="Sorcerous Restoration Feature Replacement" type="Grants" source="Internal" id="ID_INTERNAL_FEATURE_REPLACEMENT_SORCERER_SORCEROUS_RESTORATION" />

</elements>
